<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Palette -->
    <Color x:Key="ObsidianColor">#0B0B0B</Color>
    <Color x:Key="ObsidianSoftColor">#151515</Color>
    <Color x:Key="ObsidianBlueColor">#101820</Color>
    <Color x:Key="MagmaColor">#FF4500</Color>
    <Color x:Key="MagmaDarkColor">#6B1300</Color>
    <Color x:Key="GoldColor">#FFD27A</Color>
    <Color x:Key="ParchmentColor">#F5DEB3</Color>
    <Color x:Key="ParchmentDarkColor">#C9AA78</Color>

    <SolidColorBrush x:Key="ObsidianBrush" Color="{StaticResource ObsidianColor}"/>
    <SolidColorBrush x:Key="ObsidianPanelBrush" Color="#8A151515"/>
    <SolidColorBrush x:Key="DeepPanelBrush" Color="#A80F0F10"/>
    <SolidColorBrush x:Key="CardBrush" Color="#D6101820"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#8B4513"/>
    <SolidColorBrush x:Key="MagmaBrush" Color="{StaticResource MagmaColor}"/>
    <SolidColorBrush x:Key="MagmaDarkBrush" Color="{StaticResource MagmaDarkColor}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
    <SolidColorBrush x:Key="ParchmentBrush" Color="{StaticResource ParchmentColor}"/>
    <SolidColorBrush x:Key="ParchmentDarkBrush" Color="{StaticResource ParchmentDarkColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#D8D0C7"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#9AD9FF"/>
    <SolidColorBrush x:Key="OnlineBrush" Color="#00FF55"/>
    <SolidColorBrush x:Key="OfflineBrush" Color="#777777"/>

    <LinearGradientBrush x:Key="ObsidianLavaBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#070707" Offset="0"/>
        <GradientStop Color="#260303" Offset="0.35"/>
        <GradientStop Color="#101010" Offset="0.68"/>
        <GradientStop Color="#3A0B00" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderPanelBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#280000" Offset="0"/>
        <GradientStop Color="#4A0800" Offset="0.50"/>
        <GradientStop Color="#1B0000" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DarkMetalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#272727" Offset="0"/>
        <GradientStop Color="#101010" Offset="0.55"/>
        <GradientStop Color="#060606" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ParchmentGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F8E4B8" Offset="0"/>
        <GradientStop Color="#F5DEB3" Offset="0.65"/>
        <GradientStop Color="#D7B783" Offset="1"/>
    </LinearGradientBrush>

    <!-- Text -->
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="FontFamily" Value="Garamond"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="SectionHeaderText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Buttons -->
    <Style x:Key="FantasyButton" TargetType="Button">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Background" Value="#330600"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MagmaBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                        <Grid>
                            <Rectangle x:Name="Glow" Fill="#22FF4500" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#4A0C00"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1E0200"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SideNavButton" TargetType="Button" BasedOn="{StaticResource FantasyButton}">
        <Setter Property="Height" Value="58"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Background" Value="#73340700"/>
    </Style>

    <Style x:Key="SmallFantasyButton" TargetType="Button" BasedOn="{StaticResource FantasyButton}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource SmallFantasyButton}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="ShellNavButton" TargetType="Button">
        <Setter Property="Height" Value="82"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Background" Value="#22000000"/>
        <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#44FF4500"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#661E0200"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InvisibleHitboxButton" TargetType="Button">
        <Setter Property="Background" Value="#01000000"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Opacity" Value="0.01"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inputs -->
    <Style x:Key="CompactCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="0,2,0,6"/>
        <Setter Property="Background" Value="#E8E8E8"/>
    </Style>

    <Style x:Key="AttachmentListBox" TargetType="ListBox">
        <Setter Property="Background" Value="#33111111"/>
        <Setter Property="BorderBrush" Value="#6A3A24"/>
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
    </Style>

    <!-- Panels -->
    <Style x:Key="MainFrameBorder" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource MagmaBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{StaticResource ObsidianPanelBrush}"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ObsidianPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MagmaBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="FleetCardShell" TargetType="Border">
        <Setter Property="Background" Value="#8C101820"/>
        <Setter Property="BorderBrush" Value="#407A3E22"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Margin" Value="1"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRealClient}" Value="False">
                <Setter Property="Background" Value="#11171717"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PortraitFrame" TargetType="Border">
        <Setter Property="Width" Value="68"/>
        <Setter Property="Height" Value="86"/>
        <Setter Property="Background" Value="#2E1E18"/>
        <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRealClient}" Value="False">
                <Setter Property="Background" Value="#202020"/>
                <Setter Property="BorderBrush" Value="#666666"/>
                <Setter Property="Opacity" Value="0.70"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AbilityIconBorder" TargetType="Border">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Background" Value="#302214"/>
        <Setter Property="BorderBrush" Value="#8B4513"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <Style x:Key="FleetListBoxItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TechnicalLogTextBox" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#1F130D"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Courier New"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

</ResourceDictionary>
