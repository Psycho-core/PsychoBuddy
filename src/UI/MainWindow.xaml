<Window x:Class="PsychoBuddy.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PsychoBuddy - Command Center"
        Height="925"
        Width="1700"
        MinHeight="740"
        MinWidth="1360"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/assets/PsychoBuddy.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#120B0B"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PsychoTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Fixed artwork-aligned canvas. UI_Option_1_5.png supplies the visible shell. -->
    <Viewbox Stretch="Fill">
        <Canvas Width="1700" Height="925" ClipToBounds="True">
            <Image Source="pack://application:,,,/assets/UI_Option_1_5.png"
                   Width="1700"
                   Height="925"
                   Stretch="Fill"
                   IsHitTestVisible="False"/>

            <!-- Invisible drag surface over the artwork title bar. -->
            <Border Canvas.Left="78" Canvas.Top="0" Width="1500" Height="78" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

            <!-- Invisible hitboxes over artwork-provided top controls. -->
            <Button Canvas.Left="12" Canvas.Top="14" Width="58" Height="58" Style="{StaticResource InvisibleHitboxButton}" Click="MenuButton_Click"/>
            <Button Canvas.Left="1548" Canvas.Top="18" Width="52" Height="52" Style="{StaticResource InvisibleHitboxButton}" Click="MinimizeButton_Click"/>
            <Button Canvas.Left="1628" Canvas.Top="18" Width="52" Height="52" Style="{StaticResource InvisibleHitboxButton}" Click="CloseButton_Click"/>

            <!-- Invisible hitboxes over artwork-provided left navigation buttons. -->
            <Button Canvas.Left="8" Canvas.Top="112" Width="118" Height="128" Style="{StaticResource InvisibleHitboxButton}" Click="ProfilesButton_Click"/>
            <Button Canvas.Left="8" Canvas.Top="260" Width="118" Height="128" Style="{StaticResource InvisibleHitboxButton}" Click="NavigationButton_Click"/>
            <Button Canvas.Left="8" Canvas.Top="402" Width="118" Height="128" Style="{StaticResource InvisibleHitboxButton}" Click="SensesNavButton_Click"/>
            <Button Canvas.Left="8" Canvas.Top="544" Width="118" Height="128" Style="{StaticResource InvisibleHitboxButton}" Click="SettingsButton_Click"/>

            <!-- Fleet Monitor live cards aligned to the four parchment card slots. -->
            <ListBox Canvas.Left="184" Canvas.Top="172" Width="670" Height="438"
                     ItemsSource="{Binding Fleet}"
                     SelectedItem="{Binding SelectedFleetCard, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource FleetListBoxItem}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="2" Columns="2"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FleetCardShell}" Padding="6" Margin="6">
                            <Grid>
                                <!-- Empty/offline slot: minimal overlay so the artwork card remains dominant. -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRealClient}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.82">
                                        <TextBlock Text="◇" Foreground="#5C4930" FontSize="34" HorizontalAlignment="Center"/>
                                        <TextBlock Text="AWAITING CLIENT" Foreground="#3D2D18" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                        <TextBlock Text="No Session" Foreground="#5C4930" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <DockPanel Grid.Row="1" LastChildFill="False" Margin="6,0,6,0">
                                        <TextBlock DockPanel.Dock="Left" Text="RUNNING/IDLE" Foreground="#B8AA9C" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Width="58" Height="16" Background="#33111111" BorderBrush="#77444444" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center" ToolTip="Offline / No Session">
                                            <Grid>
                                                <Border Height="6" Margin="10,0,10,0" Background="#77300000" CornerRadius="3" VerticalAlignment="Center"/>
                                                <Ellipse Width="10" Height="10" Fill="#C83A30" Stroke="#3A0000" StrokeThickness="1" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DockPanel>
                                </Grid>

                                <!-- Real attached-client card. -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRealClient}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="32"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="32"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource PortraitFrame}" Width="64" Height="84">
                                        <Grid>
                                            <TextBlock Text="{Binding PortraitGlyph}" Foreground="{StaticResource GoldBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12"/>
                                            <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="2">
                                                <TextBlock Text="{Binding LevelText}" Foreground="White" FontSize="9" HorizontalAlignment="Center" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,3,0">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding CharacterName}" ToolTip="{Binding CharacterName}" Foreground="{StaticResource GoldBrush}" FontSize="14.5" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                            <Ellipse DockPanel.Dock="Right" Width="8" Height="8" Fill="{StaticResource OnlineBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Role}" Foreground="#D8D0C7" FontSize="12"/>
                                        <TextBlock Text="{Binding AssignedProfile}" Foreground="#9AD9FF" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Row="0" Grid.Column="2" Width="26" Height="26" Background="#352018" BorderBrush="#8B4513" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding RoleIcon}" Foreground="{StaticResource GoldBrush}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6,0,0" VerticalAlignment="Top">
                                        <DockPanel>
                                            <TextBlock Text="Health" Foreground="#D8D0C7" Width="52" FontSize="11"/>
                                            <TextBlock Text="{Binding HealthText}" Foreground="White" HorizontalAlignment="Right" FontSize="11"/>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding HealthPercent}" Maximum="100" Foreground="#38C94A" Background="#2B1B1B" Height="10"/>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Text="Mana" Foreground="#D8D0C7" Width="52" FontSize="11"/>
                                            <TextBlock Text="{Binding ManaText}" Foreground="White" HorizontalAlignment="Right" FontSize="11"/>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding ManaPercent}" Maximum="100" Foreground="#3F6CFF" Background="#1A172B" Height="10"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Style="{StaticResource AbilityIconBorder}">
                                                <TextBlock Text="✦" Foreground="#D9E65B" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Style="{StaticResource AbilityIconBorder}">
                                                <TextBlock Text="⚔" Foreground="#FF8C6B" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Style="{StaticResource AbilityIconBorder}" Margin="0">
                                                <TextBlock Text="◆" Foreground="#75D7FF" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding ProcessIdText}" Foreground="#B8AA9C" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding WindowHandleText}" Foreground="#B8AA9C" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" LastChildFill="False" Margin="6,0,6,0">
                                        <TextBlock DockPanel.Dock="Left" Text="RUNNING/IDLE" Foreground="#F3C6A0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Width="58" Height="16" Background="#33111111" BorderBrush="#6A3A24" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center" ToolTip="{Binding Status}">
                                            <Grid>
                                                <Border Height="6" Margin="10,0,10,0" Background="#662AC96B" CornerRadius="3" VerticalAlignment="Center"/>
                                                <Ellipse Width="10" Height="10" Fill="#20E070" Stroke="#073B1D" StrokeThickness="1" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                    </DockPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Client Attachment remains visible for debugging in the map/parchment area. -->
            <Grid Canvas.Left="922" Canvas.Top="170" Width="360" Height="430">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="CLIENT ATTACHMENT" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="{Binding SelectedAvailableClientText}" Foreground="#D8D0C7" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SelectedFleetCardText}" Foreground="#9AD9FF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.05*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,4">
                        <TextBlock Text="AVAILABLE" Foreground="#D8D0C7" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AvailableClientCountText}" Foreground="#AAA" FontSize="10" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <ListBox ItemsSource="{Binding AvailableClients}"
                                 SelectedItem="{Binding SelectedAvailableClient, Mode=TwoWay}"
                                 Height="120"
                                 Style="{StaticResource AttachmentListBox}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CharacterName}" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Pid, StringFormat=PID {0}}" Foreground="#CCCCCC" FontSize="10"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Role" Foreground="#D8D0C7" Margin="0,10,0,0"/>
                        <ComboBox Style="{StaticResource CompactCombo}" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}"/>
                        <TextBlock Text="Profile" Foreground="#D8D0C7"/>
                        <ComboBox Style="{StaticResource CompactCombo}" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="WORKFLOW" Foreground="#D8D0C7" FontWeight="Bold" Margin="0,0,0,6"/>
                        <UniformGrid Rows="6" Columns="2">
                            <Button Content="1. SCAN" Style="{StaticResource SmallFantasyButton}" Click="ScanButton_Click"/>
                            <Button Content="2. ATTACH" Style="{StaticResource SmallFantasyButton}" Click="AttachButton_Click"/>
                            <Button Content="3. START" Style="{StaticResource SmallFantasyButton}" Click="StartButton_Click"/>
                            <Button Content="PAUSE" Style="{StaticResource SmallFantasyButton}" Click="PauseButton_Click"/>
                            <Button Content="STOP" Style="{StaticResource SmallFantasyButton}" Click="StopButton_Click"/>
                            <Button Content="DETACH" Style="{StaticResource SmallFantasyButton}" Click="DetachButton_Click"/>
                            <Button Content="START ALL" Style="{StaticResource SmallFantasyButton}" Click="StartAllButton_Click"/>
                            <Button Content="STOP ALL" Style="{StaticResource SmallFantasyButton}" Click="StopAllButton_Click"/>
                            <Button Content="ADD MOCK" Style="{StaticResource SmallFantasyButton}" Click="AddMockClientButton_Click"/>
                            <Button Content="TICK" Style="{StaticResource SmallFantasyButton}" Click="TickButton_Click"/>
                            <Button Content="EMPTY" Style="{StaticResource SmallFantasyButton}" Click="EmptyButton_Click"/>
                            <Button Content="TEST PROFILE" Style="{StaticResource SmallFantasyButton}" Click="TestProfileButton_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Right-side senses controls placed into the background frames. -->
            <Grid Canvas.Left="1318" Canvas.Top="158" Width="330" Height="78">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="STEALTH&#x0a;MODE" TextAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#8C8278"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPowerModeSelected}" Value="False">
                                        <Setter Property="Foreground" Value="#FFB090"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ToggleButton Grid.Column="1" x:Name="SensesToggle" Content="SENSE" IsChecked="True" Width="86" Height="34" Click="SensesToggle_Click"/>
                    <TextBlock Grid.Column="2" Text="POWER&#x0a;MODE" TextAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#8C8278"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPowerModeSelected}" Value="True">
                                        <Setter Property="Foreground" Value="#FFB090"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding SensesModeText}" Foreground="#CCCCCC" TextAlignment="Center" FontSize="12"/>
            </Grid>

            <StackPanel Canvas.Left="1340" Canvas.Top="345" Width="290">
                <TextBlock Text="◉ Scan Range             120m" Foreground="#D8D0C7" Margin="0,0,0,8"/>
                <TextBlock Text="⚠ Threat Level           Standby" Foreground="#D8D0C7" Margin="0,0,0,8"/>
                <TextBlock Text="❖ Nearby Hostiles        0" Foreground="#D8D0C7" Margin="0,0,0,8"/>
                <TextBlock Text="➜ Navigation Path        Idle" Foreground="#D8D0C7" Margin="0,0,0,12"/>
                <Separator Margin="0,0,0,12"/>
                <TextBlock Text="{Binding FleetCountText}" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                <TextBlock Text="Build Target: .NET 8" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                <TextBlock Text="Active automation: Manual Start" Foreground="#FFAA55"/>
            </StackPanel>

            <!-- Technical log text only; parchment frame comes from the background art. -->
            <TextBox x:Name="LogTextBox"
                     Canvas.Left="160"
                     Canvas.Top="690"
                     Width="1125"
                     Height="165"
                     Text="{Binding LogText, Mode=OneWay}"
                     TextChanged="LogTextBox_TextChanged"
                     Style="{StaticResource TechnicalLogTextBox}"/>

            <!-- Footer readouts. -->
            <StatusBar Canvas.Left="0" Canvas.Top="895" Width="1700" Height="30" Background="#66000000" Foreground="#D8D0C7" FontSize="11">
                <StatusBarItem>
                    <TextBlock Text="NETWORK: standby"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="CPU: pending"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="ACTIVE PROFILE: selected per client"/>
                </StatusBarItem>
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusMessage}"/>
                </StatusBarItem>
            </StatusBar>


            <!-- Navigation modal panel. Background art supplies the visible frame; controls remain functional overlays. -->
            <Canvas Canvas.Left="0" Canvas.Top="0" Width="1700" Height="925">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavigationPanelVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>

                <Image Source="pack://application:,,,/assets/Navigation_Panel.png"
                       Width="1700"
                       Height="925"
                       Stretch="Fill"
                       IsHitTestVisible="False"/>

                <Grid Canvas.Left="285" Canvas.Top="180" Width="1130" Height="560">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Navigation Configuration" Foreground="#3D2D18" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Navigation Mode" Foreground="#3D2D18" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding NavigationModeOptions}" SelectedItem="{Binding NavigationMode, Mode=TwoWay}" Height="30" Margin="0,4,0,16"/>

                        <TextBlock Text="Route Name" Foreground="#3D2D18" FontWeight="Bold"/>
                        <TextBox Text="{Binding LastRouteName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,4,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Follow Distance (yd)" Foreground="#3D2D18" FontWeight="Bold"/>
                                <TextBox Text="{Binding FollowDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Formation Spacing (yd)" Foreground="#3D2D18" FontWeight="Bold"/>
                                <TextBox Text="{Binding FormationSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Waypoint Radius (yd)" Foreground="#3D2D18" FontWeight="Bold"/>
                        <TextBox Text="{Binding WaypointRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,4,0,16"/>

                        <CheckBox Content="Auto-follow leader" IsChecked="{Binding AutoFollowLeader, Mode=TwoWay}" Foreground="#3D2D18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <CheckBox Content="Avoid overlap / local collision" IsChecked="{Binding AvoidOverlap, Mode=TwoWay}" Foreground="#3D2D18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <CheckBox Content="Show navigation path overlay" IsChecked="{Binding ShowNavigationPath, Mode=TwoWay}" Foreground="#3D2D18" FontWeight="Bold" Margin="0,0,0,10"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Waypoint Scaffold" Foreground="#3D2D18" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding NavigationWaypoints}"
                                 SelectedItem="{Binding SelectedNavigationWaypoint, Mode=TwoWay}"
                                 Background="#55F5DEB3"
                                 BorderBrush="#8B4513"
                                 BorderThickness="1"
                                 Foreground="#2B1B12"/>

                        <UniformGrid Grid.Row="2" Rows="1" Columns="3" Margin="0,12,0,18">
                            <Button Content="ADD" Height="30" Style="{StaticResource SmallFantasyButton}" Click="AddWaypointButton_Click"/>
                            <Button Content="REMOVE" Height="30" Style="{StaticResource SmallFantasyButton}" Click="RemoveWaypointButton_Click"/>
                            <Button Content="CLEAR" Height="30" Style="{StaticResource SmallFantasyButton}" Click="ClearWaypointsButton_Click"/>
                        </UniformGrid>

                        <StackPanel Grid.Row="3">
                            <TextBlock Text="Summary" Foreground="#3D2D18" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding NavigationSummary}" Foreground="#4B3920" TextWrapping="Wrap"/>
                            <TextBlock Text="Navigation is currently a configuration/scaffold page. Real pathfinding, route recording, and movement execution are future work." Foreground="#6E2E1A" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="TEST CONFIG" Width="130" Height="34" Style="{StaticResource SmallFantasyButton}" Click="TestNavigationButton_Click"/>
                        <Button Content="SAVE NAV" Width="130" Height="34" Style="{StaticResource SmallFantasyButton}" Click="SaveNavigationButton_Click"/>
                        <Button Content="CANCEL" Width="110" Height="34" Style="{StaticResource SmallFantasyButton}" Click="CancelNavigationButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Invisible hitbox over the art-provided bottom X. -->
                <Button Canvas.Left="806" Canvas.Top="790" Width="88" Height="88" Style="{StaticResource InvisibleHitboxButton}" Click="CancelNavigationButton_Click"/>
            </Canvas>


            <!-- Senses modal panel. Background art supplies the visible frame; controls remain functional overlays. -->
            <Canvas Canvas.Left="0" Canvas.Top="0" Width="1700" Height="925">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSensesPanelVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>

                <Image Source="pack://application:,,,/assets/Senses_Panel.png"
                       Width="1700"
                       Height="925"
                       Stretch="Fill"
                       IsHitTestVisible="False"/>

                <Grid Canvas.Left="285" Canvas.Top="180" Width="1130" Height="560">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Senses Configuration" Foreground="#3D2D18" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="1" Grid.Column="0">
                        <TextBlock Text="Acquisition Mode" Foreground="#3D2D18" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding SensesModeOptions}" SelectedItem="{Binding PreferredSensesMode, Mode=TwoWay}" Height="30" Margin="0,4,0,16"/>

                        <TextBlock Text="Scan Interval (ms)" Foreground="#3D2D18" FontWeight="Bold"/>
                        <TextBox Text="{Binding SensesScanIntervalMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,4,0,16"/>

                        <TextBlock Text="Stealth Pixel Grid Offset" Foreground="#3D2D18" FontWeight="Bold"/>
                        <Grid Margin="0,4,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="X" Foreground="#3D2D18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="1" Text="{Binding StealthPixelGridX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                            <TextBlock Grid.Column="3" Text="Y" Foreground="#3D2D18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="4" Text="{Binding StealthPixelGridY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30"/>
                        </Grid>

                        <TextBlock Text="Pixel Grid Size" Foreground="#3D2D18" FontWeight="Bold"/>
                        <TextBox Text="{Binding StealthPixelGridSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,4,0,16"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="Reliability / Capture" Foreground="#3D2D18" FontWeight="Bold" FontSize="18" Margin="0,0,0,12"/>
                        <CheckBox Content="Use window capture for Stealth Mode" IsChecked="{Binding UseWindowCapture, Mode=TwoWay}" Foreground="#3D2D18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <CheckBox Content="Enable 2-frame flicker suppression" IsChecked="{Binding EnableFlickerSuppression, Mode=TwoWay}" Foreground="#3D2D18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <CheckBox Content="Enable blackout/data-loss check" IsChecked="{Binding EnableBlackoutCheck, Mode=TwoWay}" Foreground="#3D2D18" FontWeight="Bold" Margin="0,0,0,18"/>

                        <TextBlock Text="Current Summary" Foreground="#3D2D18" FontWeight="Bold" Margin="0,20,0,4"/>
                        <TextBlock Text="{Binding SensesSummary}" Foreground="#4B3920" TextWrapping="Wrap" Width="500"/>

                        <TextBlock Text="Note" Foreground="#3D2D18" FontWeight="Bold" Margin="0,22,0,4"/>
                        <TextBlock Text="These settings configure the active dashboard mode and future Power/Stealth acquisition pipeline. The real capture/addon backend is still under development." Foreground="#6E2E1A" TextWrapping="Wrap" Width="500"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="TEST CONFIG" Width="130" Height="34" Style="{StaticResource SmallFantasyButton}" Click="TestSensesButton_Click"/>
                        <Button Content="SAVE SENSES" Width="140" Height="34" Style="{StaticResource SmallFantasyButton}" Click="SaveSensesButton_Click"/>
                        <Button Content="CANCEL" Width="110" Height="34" Style="{StaticResource SmallFantasyButton}" Click="CancelSensesButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Invisible hitbox over the art-provided bottom X. -->
                <Button Canvas.Left="806" Canvas.Top="790" Width="88" Height="88" Style="{StaticResource InvisibleHitboxButton}" Click="CancelSensesButton_Click"/>
            </Canvas>


            <!-- Settings modal panel. Background art supplies the visible frame; controls remain functional overlays. -->
            <Canvas Canvas.Left="0" Canvas.Top="0" Width="1700" Height="925">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsPanelVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>

                <Image Source="pack://application:,,,/assets/Settings-Panel-final.png"
                       Width="1700"
                       Height="925"
                       Stretch="Fill"
                       IsHitTestVisible="False"/>

                <Grid Canvas.Left="285" Canvas.Top="180" Width="1130" Height="560">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Runtime / Client" Foreground="#3D2D18" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Custom WoW executable path" Foreground="#3D2D18" FontWeight="Bold"/>
                    <TextBox Grid.Row="2" Grid.Column="0" Text="{Binding CustomWowExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,4,8,14"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="BROWSE..." Width="120" Height="30" HorizontalAlignment="Left" Style="{StaticResource SmallFantasyButton}" Click="BrowseWowPathButton_Click"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Default Role" Foreground="#3D2D18" FontWeight="Bold"/>
                    <ComboBox Grid.Row="4" Grid.Column="0" ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding DefaultRole, Mode=TwoWay}" Height="30" Margin="0,4,8,14"/>

                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Default Profile" Foreground="#3D2D18" FontWeight="Bold"/>
                    <ComboBox Grid.Row="4" Grid.Column="2" ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding DefaultProfile, Mode=TwoWay}" Height="30" Margin="0,4,0,14"/>

                    <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,10,8,0">
                        <TextBlock Text="Target Game Version" Foreground="#3D2D18" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding GameVersionOptions}" SelectedItem="{Binding TargetGameVersion, Mode=TwoWay}" Height="30" Margin="0,4,0,16"/>

                        <TextBlock Text="Preferred Senses Mode" Foreground="#3D2D18" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding SensesModeOptions}" SelectedItem="{Binding PreferredSensesMode, Mode=TwoWay}" Height="30" Margin="0,4,0,16"/>

                        <TextBlock Text="Log Verbosity" Foreground="#3D2D18" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding LogVerbosityOptions}" SelectedItem="{Binding LogVerbosity, Mode=TwoWay}" Height="30" Margin="0,4,0,16"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,10,0,0">
                        <CheckBox Content="Auto-scan on startup" IsChecked="{Binding AutoScanOnStartup, Mode=TwoWay}" Foreground="#3D2D18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <CheckBox Content="Debug mode" IsChecked="{Binding DebugMode, Mode=TwoWay}" Foreground="#3D2D18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <CheckBox Content="Remember last window size/position" IsChecked="{Binding RememberWindowPlacement, Mode=TwoWay}" Foreground="#3D2D18" FontWeight="Bold" Margin="0,0,0,12"/>

                        <TextBlock Text="Notes" Foreground="#3D2D18" FontWeight="Bold" Margin="0,16,0,4"/>
                        <TextBlock Text="Settings are saved to settings.json beside the built executable. Custom path is used during client scan fallback." Foreground="#4B3920" TextWrapping="Wrap" Width="430"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="SAVE SETTINGS" Width="150" Height="34" Style="{StaticResource SmallFantasyButton}" Click="SaveSettingsButton_Click"/>
                        <Button Content="CANCEL" Width="110" Height="34" Style="{StaticResource SmallFantasyButton}" Click="CancelSettingsButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Invisible hitbox over the art-provided bottom X. -->
                <Button Canvas.Left="806" Canvas.Top="790" Width="88" Height="88" Style="{StaticResource InvisibleHitboxButton}" Click="CancelSettingsButton_Click"/>
            </Canvas>


            <!-- Profiles modal panel. Background art supplies the visible frame; controls remain functional overlays. -->
            <Canvas Canvas.Left="0" Canvas.Top="0" Width="1700" Height="925">
                <Canvas.Style>
                    <Style TargetType="Canvas">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsProfilesPanelVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Canvas.Style>

                <Image Source="pack://application:,,,/assets/Profiles_Panel.png"
                       Width="1700"
                       Height="925"
                       Stretch="Fill"
                       IsHitTestVisible="False"/>

                <Grid Canvas.Left="285" Canvas.Top="180" Width="1130" Height="560">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,16">
                        <TextBlock Text="Profile Library" Foreground="#3D2D18" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ProfileCountText}" Foreground="#5C4930" FontSize="12"/>
                    </StackPanel>

                    <ListBox Grid.Row="1" Grid.Column="0"
                             ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding SelectedProfileDefinition, Mode=TwoWay}"
                             Background="#55F5DEB3"
                             BorderBrush="#8B4513"
                             BorderThickness="1"
                             Foreground="#2B1B12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="2" BorderBrush="#7A5A2A" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" Foreground="#3D2D18"/>
                                        <TextBlock Text="{Binding MetadataSummary}" FontSize="11" Foreground="#5C4930"/>
                                        <TextBlock Text="{Binding TagSummary}" FontSize="10" Foreground="#6E5532" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBlock Text="Selected Profile" Foreground="#3D2D18" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding SelectedProfileDetails}" Foreground="#3D2D18" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SelectedProfileDefinition.RuleSummary}" Foreground="#5C4930" FontSize="12" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Description" Foreground="#3D2D18" FontWeight="Bold" Margin="0,10,0,4"/>
                        <TextBlock Text="{Binding SelectedProfileDescription}" Foreground="#4B3920" TextWrapping="Wrap" FontSize="13" Width="590"/>

                        <TextBlock Text="Current dashboard profile dropdown is populated from these JSON files." Foreground="#4B3920" TextWrapping="Wrap" Margin="0,28,0,0"/>
                        <TextBlock Text="Profile behavior is still placeholder-level until real rotation/profile execution is implemented." Foreground="#6E2E1A" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="USE SELECTED" Width="140" Height="34" Style="{StaticResource SmallFantasyButton}" Click="UseSelectedProfileButton_Click"/>
                        <Button Content="RELOAD" Width="100" Height="34" Style="{StaticResource SmallFantasyButton}" Click="ReloadProfilesButton_Click"/>
                        <Button Content="CLOSE" Width="100" Height="34" Style="{StaticResource SmallFantasyButton}" Click="CloseProfilesButton_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Invisible hitbox over the art-provided bottom X. -->
                <Button Canvas.Left="806" Canvas.Top="790" Width="88" Height="88" Style="{StaticResource InvisibleHitboxButton}" Click="CloseProfilesButton_Click"/>
            </Canvas>

        </Canvas>
    </Viewbox>
</Window>
