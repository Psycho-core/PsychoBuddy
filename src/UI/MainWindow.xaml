<Window x:Class="PsychoBuddy.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PsychoBuddy - Command Center"
        Height="820"
        Width="1280"
        MinHeight="720"
        MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#120B0B">

    <Window.Resources>
        <SolidColorBrush x:Key="ObsidianBrush" Color="#171717"/>
        <SolidColorBrush x:Key="ObsidianPanelBrush" Color="#D0151515"/>
        <SolidColorBrush x:Key="MagmaBrush" Color="#FF4500"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#FFD27A"/>
        <SolidColorBrush x:Key="ParchmentBrush" Color="#F5DEB3"/>

        <Style x:Key="FantasyButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#2D0000"/>
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MagmaBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SmallFantasyButton" TargetType="Button" BasedOn="{StaticResource FantasyButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B0B0B" Offset="0"/>
                <GradientStop Color="#240606" Offset="0.42"/>
                <GradientStop Color="#101010" Offset="0.7"/>
                <GradientStop Color="#3A0B00" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#2D0000" BorderBrush="{StaticResource MagmaBrush}" BorderThickness="0,0,0,2">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="☰" Foreground="{StaticResource GoldBrush}" FontSize="34" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="PsychoBuddy" Foreground="{StaticResource GoldBrush}" FontSize="34" FontFamily="Garamond" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="FLEET COMMAND INTERFACE" Foreground="#CCB7A0" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="COMMAND CENTER" Foreground="{StaticResource GoldBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="_" Width="34" Height="28" Style="{StaticResource SmallFantasyButton}"/>
                    <Button Content="X" Width="34" Height="28" Style="{StaticResource SmallFantasyButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT NAVIGATION -->
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <Button Content="PROFILES" Style="{StaticResource FantasyButton}"/>
                <Button Content="NAVIGATION" Style="{StaticResource FantasyButton}"/>
                <Button Content="SENSES" Style="{StaticResource FantasyButton}"/>
                <Button Content="SETTINGS" Style="{StaticResource FantasyButton}"/>
                <Button Content="SCAN" Style="{StaticResource FantasyButton}" Click="ScanButton_Click" Margin="0,22,0,8"/>
                <Button Content="DEMO" Style="{StaticResource FantasyButton}" Click="DemoButton_Click"/>
                <Button Content="TICK" Style="{StaticResource FantasyButton}" Click="TickButton_Click"/>
            </StackPanel>

            <!-- CENTER COMMAND PANEL -->
            <Border Grid.Column="1" BorderBrush="{StaticResource MagmaBrush}" BorderThickness="2" CornerRadius="8" Background="{StaticResource ObsidianPanelBrush}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="FLEET MONITOR" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#D6C7B7" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ATTACHED FLEET CARDS -->
                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding Fleet}"
                                 SelectedItem="{Binding SelectedFleetCard, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#DD101820" BorderBrush="#6A3A24" BorderThickness="1" Margin="6" CornerRadius="6" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Width="62" Height="72" Background="#2E1E18" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="3" Margin="0,0,10,0">
                                                <TextBlock Text="☠" Foreground="{StaticResource GoldBrush}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Text="{Binding CharacterName}" Foreground="{StaticResource GoldBrush}" FontSize="20" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Role}" Foreground="#D8D0C7" FontSize="13"/>
                                                <TextBlock Text="{Binding AssignedProfile}" Foreground="#9AD9FF" FontSize="11"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="Health" Foreground="#D8D0C7" Width="55"/>
                                                    <TextBlock Text="{Binding HealthPercent, StringFormat={}{0:0}%}" Foreground="White" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <ProgressBar Value="{Binding HealthPercent}" Maximum="100" Foreground="#38C94A" Background="#2B1B1B" Height="12"/>
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock Text="Mana" Foreground="#D8D0C7" Width="55"/>
                                                    <TextBlock Text="{Binding ManaPercent, StringFormat={}{0:0}%}" Foreground="White" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <ProgressBar Value="{Binding ManaPercent}" Maximum="100" Foreground="#3F6CFF" Background="#1A172B" Height="12"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding ProcessIdText}" Foreground="#B8AA9C" FontSize="10"/>
                                                <TextBlock Text="{Binding WindowHandleText}" Foreground="#B8AA9C" FontSize="10"/>
                                            </StackPanel>

                                            <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                                <TextBlock Text="RUNNING/IDLE" Foreground="#F3C6A0" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Status}" Foreground="#00FF99" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- MAP + CLIENT ATTACHMENT WORKFLOW -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="1.15*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#E6D7B37A" BorderBrush="#8B4513" BorderThickness="2" CornerRadius="4" Padding="10">
                                <Grid>
                                    <TextBlock Text="TACTICAL MAP" Foreground="#4B2C20" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                                    <Canvas Margin="12,34,12,12">
                                        <Rectangle Width="260" Height="140" Stroke="#704214" StrokeThickness="2" Fill="#22FFFFFF"/>
                                        <Line X1="20" Y1="110" X2="230" Y2="25" Stroke="#A33A00" StrokeThickness="4"/>
                                        <Line X1="35" Y1="20" X2="240" Y2="125" Stroke="#7A1B00" StrokeThickness="2"/>
                                        <Ellipse Canvas.Left="122" Canvas.Top="58" Width="36" Height="36" Fill="#D88A00" Stroke="#4B2C20" StrokeThickness="3"/>
                                        <Ellipse Canvas.Left="65" Canvas.Top="95" Width="10" Height="10" Fill="#00FF99"/>
                                        <Ellipse Canvas.Left="180" Canvas.Top="45" Width="10" Height="10" Fill="#00CCFF"/>
                                        <Ellipse Canvas.Left="210" Canvas.Top="100" Width="10" Height="10" Fill="#FF5555"/>
                                    </Canvas>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Background="#DD1A1A1A" BorderBrush="{StaticResource MagmaBrush}" BorderThickness="2" CornerRadius="6" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="CLIENT ATTACHMENT" Foreground="{StaticResource GoldBrush}" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <DockPanel>
                                                <TextBlock Text="AVAILABLE" Foreground="#D8D0C7" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding AvailableClientCountText}" Foreground="#AAA" FontSize="10" HorizontalAlignment="Right"/>
                                            </DockPanel>
                                            <ListBox ItemsSource="{Binding AvailableClients}"
                                                     SelectedItem="{Binding SelectedAvailableClient, Mode=TwoWay}"
                                                     Height="96"
                                                     Background="#33111111"
                                                     BorderBrush="#6A3A24">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding CharacterName}" Foreground="{StaticResource GoldBrush}" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding Pid, StringFormat=PID {0}}" Foreground="#CCCCCC" FontSize="10"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <TextBlock Text="Role" Foreground="#D8D0C7" Margin="0,8,0,0"/>
                                            <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}"/>
                                            <TextBlock Text="Profile" Foreground="#D8D0C7"/>
                                            <ComboBox ItemsSource="{Binding ProfileOptions}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="WORKFLOW" Foreground="#D8D0C7" FontWeight="Bold"/>
                                            <Button Content="1. SCAN CLIENTS" Style="{StaticResource SmallFantasyButton}" Click="ScanButton_Click"/>
                                            <Button Content="2. ATTACH SELECTED" Style="{StaticResource SmallFantasyButton}" Click="AttachButton_Click"/>
                                            <Button Content="3. START SELECTED" Style="{StaticResource SmallFantasyButton}" Click="StartButton_Click"/>
                                            <Button Content="PAUSE SELECTED" Style="{StaticResource SmallFantasyButton}" Click="PauseButton_Click"/>
                                            <Button Content="STOP SELECTED" Style="{StaticResource SmallFantasyButton}" Click="StopButton_Click"/>
                                            <Button Content="DETACH SELECTED" Style="{StaticResource SmallFantasyButton}" Click="DetachButton_Click"/>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Content="START ALL" Width="86" Style="{StaticResource SmallFantasyButton}" Click="StartAllButton_Click"/>
                                                <Button Content="STOP ALL" Width="78" Style="{StaticResource SmallFantasyButton}" Click="StopAllButton_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT SENSES PANEL -->
            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                <Border Background="{StaticResource ObsidianPanelBrush}" BorderBrush="{StaticResource MagmaBrush}" BorderThickness="2" Padding="12" Margin="0,0,0,16" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="SENSES MODULE" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                        <Grid Margin="0,16,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="STEALTH&#x0a;MODE" Foreground="#D8D0C7" TextAlignment="Center"/>
                            <ToggleButton Grid.Column="1" x:Name="SensesToggle" Content="SENSE" IsChecked="True" Width="86" Height="34" Click="SensesToggle_Click"/>
                            <TextBlock Grid.Column="2" Text="POWER&#x0a;MODE" Foreground="#FFB090" TextAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding SensesModeText}" Foreground="#CCCCCC" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource ObsidianPanelBrush}" BorderBrush="{StaticResource MagmaBrush}" BorderThickness="2" Padding="12" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="SENSES STATUS" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="◉ Scan Range             120m" Foreground="#D8D0C7" Margin="0,14,0,0"/>
                        <TextBlock Text="⚠ Threat Level           Standby" Foreground="#D8D0C7" Margin="0,8,0,0"/>
                        <TextBlock Text="❖ Nearby Hostiles        0" Foreground="#D8D0C7" Margin="0,8,0,0"/>
                        <TextBlock Text="➜ Navigation Path        Idle" Foreground="#D8D0C7" Margin="0,8,0,0"/>
                        <Separator Margin="0,12,0,12"/>
                        <TextBlock Text="{Binding FleetCountText}" Foreground="#CCCCCC"/>
                        <TextBlock Text="Build Target: .NET 8" Foreground="#CCCCCC" Margin="0,5,0,0"/>
                        <TextBlock Text="Active automation: Manual Start" Foreground="#FFAA55" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- BOTTOM TECHNICAL LOG -->
        <Border Grid.Row="2" Margin="132,0,312,10" Background="{StaticResource ParchmentBrush}" CornerRadius="5" BorderBrush="#8B4513" BorderThickness="3">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#33100000" BorderBrush="#8B4513" BorderThickness="0,0,0,1" Padding="10,4">
                    <TextBlock Text="TECHNICAL LOG" Foreground="#3A1300" FontWeight="Bold" FontSize="16"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding LogText}" TextWrapping="Wrap" Foreground="#1F130D" FontFamily="Courier New" FontSize="14" Padding="12"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- FOOTER -->
        <StatusBar Grid.Row="3" Background="#090909" Foreground="#D8D0C7" FontSize="11">
            <StatusBarItem>
                <TextBlock Text="NETWORK: standby"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="CPU: pending"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="ACTIVE PROFILE: selected per client"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
