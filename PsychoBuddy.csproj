<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>assets\PsychoBuddy.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="src\App.xaml" />
    <ApplicationDefinition Include="src\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\PsychoBuddy.ico" />
    <Resource Include="assets\UI_Option_1_1.png" />
    <Resource Include="assets\UI_Option_1_5.png" />
    <Resource Include="assets\Settings-Panel-final.png" />
    <Resource Include="assets\Profiles_Panel.png" />
    <Resource Include="assets\Senses_Panel.png" />
    <Resource Include="assets\Navigation_Panel.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="profiles\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Debug-build guard:
    If an older PsychoBuddy.exe is still running, Windows locks the output .exe/.dll and MSBuild raises
    MSB3021 / MSB3026 / MSB3027 / MSB3061. This target tries to close any running PsychoBuddy.exe
    before a Debug build copies the new apphost into bin\Debug\net8.0-windows.
  -->
  <Target Name="StopRunningPsychoBuddyBeforeDebugBuild"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Debug' and '$(OS)' == 'Windows_NT'">
    <Exec Command="taskkill /IM PsychoBuddy.exe /F /T &gt;NUL 2&gt;NUL" IgnoreExitCode="true" />
  </Target>

</Project>
