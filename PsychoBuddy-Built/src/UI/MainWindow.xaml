<Window x:Class="PsychoBuddy.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PsychoBuddy - Command Center" Height="800" Width="1200"
        Background="#1A1A1A" WindowStyle="None" AllowsTransparency="True">

    <Grid>
        <!-- BACKGROUND: Obsidian and Lava Theme -->
        <Image Source="assets/background_obsidian.png" Stretch="Fill" Opacity="0.8"/>
        
        <!-- TOP BAR: PsychoBuddy Header -->
        <Border VerticalAlignment="Top" Height="60" Background="#2D0000" BorderBrush="#FF4500" BorderThickness="0,0,0,2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="PsychoBuddy" Foreground="#FFD700" FontSize="24" FontFamily="Garamond" FontWeight="Bold"/>
                <TextBlock Text=" - COMMAND CENTER" Foreground="#AAA" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- LEFT SIDEBAR: Navigation -->
        <StackPanel Width="120" HorizontalAlignment="Left" Margin="10,70,0,0">
            <Button Content="PROFILES" Style="{StaticResource FantasyButton}" Margin="0,0,0,10"/>
            <Button Content="NAVIGATION" Style="{StaticResource FantasyButton}" Margin="0,0,0,10"/>
            <Button Content="SENSES" Style="{StaticResource FantasyButton}" Margin="0,0,0,10"/>
            <Button Content="SETTINGS" Style="{StaticResource FantasyButton}" Margin="0,0,0,10"/>
        </StackPanel>

        <!-- MAIN AREA: Fleet Monitor -->
        <Grid Margin="140,70,300,150">
            <Border Background="#330000" CornerRadius="10" BorderBrush="#FF4500" BorderThickness="2">
                <ItemsControl ItemsSource="{Binding Fleet}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" Rows="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Fleet Card implementation -->
                            <Border Background="#111" BorderBrush="#555" BorderThickness="1" Margin="10" CornerRadius="5">
                                <StackPanel Margin="10">
                                    <TextBlock Text="{Binding CharacterName}" Foreground="#FFD700" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Role}" Foreground="#AAA" FontSize="12"/>
                                    <ProgressBar Value="{Binding HealthPercent}" Foreground="Green" Height="10" Margin="0,5,0,0"/>
                                    <ProgressBar Value="{Binding ManaPercent}" Foreground="Blue" Height="10" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Status}" Foreground="Cyan" FontSize="10" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- RIGHT PANEL: Senses Module -->
        <StackPanel Width="250" HorizontalAlignment="Right" Margin="0,70,20,0">
            <Border Background="#222" BorderBrush="#FF4500" BorderThickness="2" Padding="10" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="SENSES MODULE" Foreground="#FFD700" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <ToggleButton x:Name="SensesToggle" Content="STEALTH / POWER" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <Border Background="#222" BorderBrush="#FF4500" BorderThickness="2" Padding="10">
                <StackPanel>
                    <TextBlock Text="SENSES STATUS" Foreground="#FFD700" HorizontalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="Scan Range: 120m" Foreground="#AAA" Margin="0,5,0,0"/>
                    <TextBlock Text="Threat Level: High" Foreground="Red" Margin="0,5,0,0"/>
                    <TextBlock Text="Nearby Hostiles: 6" Foreground="#AAA" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- BOTTOM PANEL: Technical Log -->
        <Border VerticalAlignment="Bottom" Height="120" Margin="20,0,20,20" Background="#F5DEB3" CornerRadius="5" BorderBrush="#8B4513" BorderThickness="3">
            <ScrollViewer>
                <TextBlock x:Name="LogOutput" TextWrapping="Wrap" Foreground="#4B2C20" FontFamily="Courier New" Padding="10"/>
            </ScrollViewer>
        </Border>

        <!-- FOOTER: System Stats -->
        <StatusBar VerticalAlignment="Bottom" Height="30" Background="#000" Foreground="#AAA" FontSize="10">
            <StatusBarItem Content="NETWORK: 12ms"/>
            <StatusBarItem Content="CPU: 24%"/>
            <StatusBarItem Content="UPTIME: 3:14:08"/>
            <StatusBarItem HorizontalAlignment="Right" Content="ACTIVE PROFILE: RAID_ALPHA"/>
        </StatusBar>
    </Grid>
</Window>
